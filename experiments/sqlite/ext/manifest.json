{
  "name": "SQLite spike probe",
  "version": "0.0.1",
  "manifest_version": 3,
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
